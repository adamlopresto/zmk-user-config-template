// right hand trackball configuration

&trackball_peripheral_listener {
    input-processors = <&zip_auto_mouse 10 150>, <&zip_xy_scaler 0 1>;

    //     input-processors = <&zip_xy_scaler 2 3>;
    /*
    ignore_right {
        layers = <11>;
        input-processors = <&zip_xy_scaler 0 1>;
    };
    */

    arrows {
        layers = <3>;
        input-processors = <&zip_keybind_keys>;
        process-next;
    };

    arrows_prevent_movement {
        layers = <3>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    as_mouse {
        layers = <5 10>;
        input-processors = <&zip_xy_scaler 2 3>;
    };

    while_scrolling {
        layers = <11>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    // multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
    // /* make this trackball output scrolling events by default instead of cursor movement */
    // /* invert vertical scrolling so that the view moves in the same direction as the top of the trackball */

    scroller {
        layers = <7>;
        input-processors =
            <&zip_xy_scaler 1 16>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };
};

//left hand trackball configuration

&trackball_central_listener {
    input-processors = <&zip_auto_mouse 11 500>, <&zip_xy_scaler 0 1>;

    /*   
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
        <&zip_xy_scaler 1 16>,
            // make this trackball output scrolling events by default instead of cursor movement
            <&zip_xy_to_scroll_mapper>,
                // invert vertical scrolling so that the view moves in the same direction as the top of the trackball
                <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
                */
    /*
                ignore_left {
                    layers = <11>;
                    input-processors = <&zip_xy_scaler 0 1>;
                };
                */

    as_scrollwheel {
        layers = <11>;
        input-processors =
            <&zip_x_scaler 0 16>,
            <&zip_y_scaler 1 16>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };

    volume_override {
        layers = <1>;
        input-processors = <&zip_scroll_to_vol>;
        process-next;
    };

    volume_override_prevent_movement {
        layers = <1>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    as_horiz_scrollwheel {
        layers = <2>;
        input-processors =
            <&zip_x_scaler 1 16>,
            <&zip_y_scaler 0 16>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
    };

    tracker {
        layers = <7>;
        input-processors = <&zip_xy_scaler 2 3>;
    };
};

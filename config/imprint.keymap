        qu_sentence_start_combo {
            bindings = <&qu_macro_sentence_start>;
            key-positions = <31 44>;
            layers = <8>;
        };

        dummy_combo {
            bindings = <&none>;
            key-positions = <63 71 43 44 45 46 62>;

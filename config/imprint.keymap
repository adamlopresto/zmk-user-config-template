    combos {
        compatible = "zmk,combos";

        combo_new_sentence {
            bindings = <&sentence_end PERIOD>;
            key-positions = <43 44>;
            layers = <0 6 7 11 10>;
        };

        question_combo {
            bindings = <&sentence_end QUESTION>;
            key-positions = <44 45>;
            layers = <0 6 7 11 10>;
        };

        bang_combo {
            bindings = <&sentence_end EXCLAMATION>;
            key-positions = <45 46>;
            layers = <0 6 7 11 10>;
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
        };

        mouse_combo {
            bindings = <&rgb_layer_to_yellow 5>;
            key-positions = <73 54>;
            layers = <0 1 3 2 6 7 8 10 11>;
        };

        mouse_combo2 {
            bindings = <&mkp RCLK>;
            key-positions = <74 42>;
        };

        capslock_combo {
            bindings = <&kp CAPSLOCK>;
            key-positions = <48 71>;
        };

        magic_combo {
            bindings = <&kp F13>;
            key-positions = <70 75>;
        };

        mouse1_combo {
            bindings = <&mkp LCLK>;
            key-positions = <40 39>;
        };

        mouse2_combo {

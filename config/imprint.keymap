            key-positions = <38 37>;
            timeout-ms = <40>;
            require-prior-idle-ms = <500>;
        };

        to0_combo {
            bindings = <&unshift_to_0>;
            key-positions = <37 40>;
        };

        ough_combo {
            bindings = <&ough_macro>;
            key-positions = <31 33>;
            require-prior-idle-ms = <10>;
            timeout-ms = <30>;
        };

        tion_combo {
            bindings = <&tion_macro>;
            key-positions = <33 32>;
            timeout-ms = <30>;
            require-prior-idle-ms = <10>;
        };

        ing_combo {
            bindings = <&ing_macro>;
